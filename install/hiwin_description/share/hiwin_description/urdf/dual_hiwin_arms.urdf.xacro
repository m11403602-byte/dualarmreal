<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro" name="dual_hiwin">

    <!-- HIWIN 原廠手臂 macro -->
    <xacro:include filename="$(find hiwin_description)/urdf/ra_macro.xacro" />

    <!-- 你的平台 macro -->
    <xacro:include filename="$(find hiwin_description)/urdf/big_arm_platform.urdf.xacro" />
    <xacro:include filename="$(find hiwin_description)/urdf/small_arm_platform.urdf.xacro" />

    <!-- World -->
    <link name="world"/>

    <!-- ========================================================== -->
    <!-- 大手臂 RA610 (big) = 基準, 平台放在 world 原點             -->
    <!-- ========================================================== -->
    <xacro:big_arm_platform
        tf_prefix="big_"
        parent="world">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:big_arm_platform>

    <xacro:hiwin_arm
        name="big_arm"
        tf_prefix="big_"
        parent="big_platform_top_link"
        joint_limits_parameters_file="$(find hiwin_description)/config/ra610_1476/joint_limits.yaml"
        kinematics_parameters_file="$(find hiwin_description)/config/ra610_1476/default_kinematics.yaml"
        visual_parameters_file="$(find hiwin_description)/config/ra610_1476/visual_parameters.yaml">
        <!-- ⚠ 一致性: 此 z=0.117 必須 = platform_offsets.yaml 的 b2_platform_to_b2 -->
        <origin xyz="0 0 0.117" rpy="0 0 0"/>
    </xacro:hiwin_arm>

    <!-- ========================================================== -->
    <!-- 小手臂 RA605 (small) = 用相機校準值定位                    -->
    <!-- ========================================================== -->
    <xacro:small_arm_platform
        tf_prefix="small_"
        parent="world">
        <!-- ★★★ 校準值填這裡 ★★★                                            -->
        <!-- 來源: solver 輸出 urdf_origin_b2plat_to_b1plat (T_b1_b2.yaml)     -->
        <!-- 重採校準後, 換成新的 solver 輸出即可, 其餘都不用動.              -->        
        <origin xyz="0.0 1.4 0.0" rpy="0.0 0.0 3.1415926"/>
        <!--origin xyz="-0.053864 1.430586 0.029790" rpy="-0.006355 -0.013569 -3.128932"/-->
    </xacro:small_arm_platform>

    <xacro:hiwin_arm
        name="small_arm"
        tf_prefix="small_"
        parent="small_platform_top_link"
        joint_limits_parameters_file="$(find hiwin_description)/config/ra605_710/joint_limits.yaml"
        kinematics_parameters_file="$(find hiwin_description)/config/ra605_710/default_kinematics.yaml"
        visual_parameters_file="$(find hiwin_description)/config/ra605_710/visual_parameters.yaml">
        <!-- ⚠ 一致性: 此 z=0.802 必須 = platform_offsets.yaml 的 b1_platform_to_b1 -->
        <origin xyz="0 0 0.802" rpy="0 0 0"/>
    </xacro:hiwin_arm>

</robot>